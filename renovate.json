{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "timezone": "Europe/Berlin",
  "schedule": ["* 10-17 * * 1"],
  "minimumReleaseAge": "7 days",
  "dependencyDashboardApproval": true,
  "customManagers": [
    {
      "description": "plv8's version: the Dockerfile, the bake file and the workflow's image tag",
      "customType": "regex",
      "managerFilePatterns": ["/^plv8/(Dockerfile|docker-bake\\.hcl)$/", "/^\\.github/workflows/build-plv8\\.yml$/"],
      "matchStrings": [
        "PLV8_VERSION=(?<currentValue>\\S+)",
        "PLV8_VERSION: \"(?<currentValue>[^\"]+)\"",
        "variable \"PLV8_VERSION\" \\{\\s*default = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "plv8/plv8",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "description": "pgmq's version: the Dockerfile's version and tag, and the bake file",
      "customType": "regex",
      "managerFilePatterns": ["/^pgmq/(Dockerfile|docker-bake\\.hcl)$/"],
      "matchStrings": [
        "PGMQ_VERSION=(?<currentValue>\\S+)",
        "PGMQ_TAG='v(?<currentValue>[^']+)'",
        "variable \"PGMQ_VERSION\" \\{\\s*default = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "pgmq/pgmq",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "description": "pg_cron's version: the Dockerfile's version and tag, and the bake file",
      "customType": "regex",
      "managerFilePatterns": ["/^pg_cron/(Dockerfile|docker-bake\\.hcl)$/"],
      "matchStrings": [
        "PG_CRON_VERSION=(?<currentValue>\\S+)",
        "PG_CRON_TAG='v(?<currentValue>[^']+)'",
        "variable \"PG_CRON_VERSION\" \\{\\s*default = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "citusdata/pg_cron",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "PG_MAJOR is 18 throughout: a new major is a migration, not an update",
      "matchPackageNames": ["postgres", "ghcr.io/cloudnative-pg/postgresql"],
      "allowedVersions": "/^18\\./",
      "groupName": "postgres 18 base images"
    },
    {
      "description": "The combined image builds from the extension images, which exist only once their own builds publish",
      "matchPackageNames": ["ghcr.io/stackables/**"],
      "enabled": false
    },
    {
      "matchDepNames": ["plv8/plv8"],
      "groupName": "plv8",
      "prBodyNotes": [
        "plv8 builds the tip of PLV8_BRANCH, not the tag: on a new minor, set it to r<major>.<minor>. Update the README table, and the postgres image's FROM once the new image is published."
      ]
    },
    {
      "matchDepNames": ["pgmq/pgmq"],
      "groupName": "pgmq",
      "prBodyNotes": [
        "Update the README table, and the postgres image's FROM once the new image is published."
      ]
    },
    {
      "matchDepNames": ["citusdata/pg_cron"],
      "groupName": "pg_cron",
      "prBodyNotes": [
        "Update the README table, and the postgres image's FROM once the new image is published."
      ]
    }
  ]
}
